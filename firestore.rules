rules_version = '2';

// Pickleball Greece: regole di accesso al database.
// - Tutti possono leggere gruppo, giocatori (nome/cognome/sesso), tornei, corsi e sfide.
// - Email e telefono (raccolta "users") li vedono solo l'interessato e gli amministratori.
// - Gli utenti registrati possono: modificare il proprio profilo, lanciare sfide e candidarsi a quelle
//   degli altri, gestire il torneo nato dalla propria sfida, iscriversi/ritirarsi da tornei e corsi.
// - Le candidature alle sfide (nomi) le vedono solo il candidato, chi ha lanciato la sfida e gli admin.
// - Tutto il resto solo gli amministratori (UID principale qui sotto + raccolta "admins").
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && (request.auth.uid in ['T9wW3CKIW7YoFgyBxZ2WuUrasFF3']
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    // Gestore tornei: crea e gestisce i tornei, senza gli altri poteri dell'amministratore.
    function isTourAdmin() {
      return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/tourAdmins/$(request.auth.uid)));
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    // Utente con indirizzo email confermato (link ricevuto dopo la registrazione).
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function data() { return request.resource.data; }
    function shortText(v, max) { return v is string && v.size() <= max; }
    // livello di gioco facoltativo: 1 principiante … 5 pro
    function validLevel() { return !('livello' in data()) || data().livello in [1, 2, 3, 4, 5]; }

    match /data/{docId} {
      allow read: if true;
      allow write: if isAdmin() && docId in ['settings', 'articoli'];
    }

    match /players/{uid} {
      allow read: if true;
      allow write: if isAdmin();
      allow create, update: if isSelf(uid)
        && data().keys().hasOnly(['nome', 'cognome', 'sesso', 'livello']) && validLevel()
        && shortText(data().nome, 60) && shortText(data().cognome, 60) && data().sesso in ['M', 'F'];
      // Il gestore tornei inserisce i giocatori senza account (sesso facoltativo nei tornei open).
      allow create, update: if isTourAdmin()
        && data().keys().hasOnly(['nome', 'cognome', 'sesso', 'livello']) && validLevel()
        && shortText(data().nome, 60) && shortText(data().cognome, 60) && data().sesso in ['M', 'F', ''];
      // Chi organizza una sfida a torneo può aggiungere giocatori senza account (id generati dall'app, non UID).
      allow create: if (verified() || isAdmin()) && uid.matches('u[a-z0-9]{6,20}')
        && data().keys().hasOnly(['nome', 'cognome', 'sesso', 'livello']) && validLevel()
        && shortText(data().nome, 60) && shortText(data().cognome, 60) && data().sesso in ['M', 'F', ''];
    }

    match /tourAdmins/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isAdmin();
      allow create, update: if isSelf(uid)
        && data().keys().hasOnly(['email', 'tel', 'tema'])
        && data().email == request.auth.token.email
        && shortText(data().tel, 30) && shortText(data().tema, 20);
    }

    match /admins/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Leghe: le crea l'admin, che sceglie gli admin di lega; l'admin di lega modifica la sua lega
    // (giocatori abilitati, tornei, chiusura) ma non l'elenco degli admin di lega.
    function legaAdmin(lid) {
      return signedIn() && lid is string && lid != ''
        && request.auth.uid in get(/databases/$(database)/documents/leghe/$(lid)).data.admins;
    }
    match /leghe/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if legaAdmin(id) && data().admins == resource.data.admins;
    }

    // Sfide: le lancia un utente registrato (by = chi la lancia); la modifica e la cancella lui o un admin.
    match /sfide/{id} {
      allow read: if true;
      allow create: if (verified() || isAdmin()) && data().by == request.auth.uid
        && data().data is string && data().ora is string
        && (!('lega' in data()) || data().lega == '' || isAdmin() || legaAdmin(data().lega));
      allow update: if signedIn() && (resource.data.by == request.auth.uid || isAdmin())
        && data().by == resource.data.by;
      allow delete: if signedIn() && (resource.data.by == request.auth.uid || isAdmin());
    }

    // Candidature: id = sfida_utente; org = chi ha lanciato la sfida.
    function sfidaOf(sid) { return get(/databases/$(database)/documents/sfide/$(sid)).data; }
    match /sfideRisp/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || resource.data.org == request.auth.uid || isAdmin());
      allow create: if (verified() || isAdmin())
        && data().uid == request.auth.uid && id == data().sid + '_' + request.auth.uid
        && data().stato == 'attesa' && data().org == sfidaOf(data().sid).by
        && sfidaOf(data().sid).stato == 'aperta' && data().org != request.auth.uid;
      // il candidato può solo ritirarsi o segnare come letto l'avviso; chi organizza (o l'admin) conferma o rifiuta
      allow update: if signedIn() && data().sid == resource.data.sid && data().uid == resource.data.uid && data().org == resource.data.org
        && (resource.data.org == request.auth.uid || isAdmin()
            || (resource.data.uid == request.auth.uid && data().diff(resource.data).affectedKeys().hasOnly(['stato', 'visto', 'at'])
                && (data().stato == resource.data.stato || data().stato == 'ritirata')));
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || resource.data.org == request.auth.uid || isAdmin());
    }

    // Avvisi per un utente o per "admins".
    match /notifiche/{id} {
      allow read: if signedIn() && (resource.data.to == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && data().keys().hasOnly(['to', 'text', 'at', 'by'])
        && data().by == request.auth.uid && shortText(data().text, 400) && data().to is string;
      allow delete: if signedIn() && (resource.data.to == request.auth.uid || isAdmin());
    }

    match /courses/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /enrollments/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow create: if verified()
        && data().keys().hasOnly(['courseId', 'userId', 'at'])
        && data().userId == request.auth.uid
        && id == data().courseId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/courses/$(data().courseId));
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Torneo nato da una sfida: lo gestisce chi l'ha lanciata (owner), come un gestore tornei.
    match /tournaments/{id} {
      allow read: if true;
      allow write: if isTourAdmin();
      allow create: if (verified() || isAdmin()) && data().owner == request.auth.uid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid && data().owner == request.auth.uid;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
      // admin di lega: tornei della sua lega
      allow create: if legaAdmin(data().lega);
      allow update: if legaAdmin(resource.data.lega) && (data().lega == resource.data.lega || legaAdmin(data().lega) || data().lega == '');
      allow delete: if legaAdmin(resource.data.lega);
    }
    function tourOwner(tid) {
      let t = getAfter(/databases/$(database)/documents/tournaments/$(tid)).data;
      return signedIn() && (t.owner == request.auth.uid || legaAdmin(t.lega));
    }

    match /entries/{id} {
      allow read: if true;
      allow write: if isTourAdmin();
      allow create, update: if tourOwner(data().tid);
      // (anche le iscrizioni rimaste di un torneo già eliminato)
      allow delete: if signedIn() && (!exists(/databases/$(database)/documents/tournaments/$(resource.data.tid))
        || get(/databases/$(database)/documents/tournaments/$(resource.data.tid)).data.owner == request.auth.uid
        || legaAdmin(get(/databases/$(database)/documents/tournaments/$(resource.data.tid)).data.lega));
      allow create: if verified()
        && data().keys().hasOnly(['tid', 'p1', 'p2', 'at'])
        && data().p1 == request.auth.uid && data().p2 != request.auth.uid
        && get(/databases/$(database)/documents/tournaments/$(data().tid)).data.open == true;
      allow delete: if signedIn()
        && (resource.data.p1 == request.auth.uid || resource.data.p2 == request.auth.uid)
        && get(/databases/$(database)/documents/tournaments/$(resource.data.tid)).data.open == true;
    }
  }
}
